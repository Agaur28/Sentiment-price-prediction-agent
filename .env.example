APIFY_TOKEN=your_apify_token
EXA_API_KEY=your_exa_key
# Apify actors for sources that have no built-in scraper (pick from apify.com/store, paste "username/actor-name")
ACTOR_LIHKG=
ACTOR_FUTU=
ACTOR_TELEGRAM=
# Input JSON per actor. {query} is replaced by the search term. Adjust keys to the actor's input schema.
ACTOR_INPUT_LIHKG={"searchTerms":["{query}"],"maxItems":200}
ACTOR_INPUT_FUTU={"searchTerms":["{query}"],"maxItems":200}
ACTOR_INPUT_TELEGRAM={"search":"{query}","maxItems":200}

# Public Telegram channels (comma separated, no @) that discuss the stocks. Scraped via t.me/s/<channel>
TELEGRAM_CHANNELS_HKEX=
TELEGRAM_CHANNELS_KRX=
